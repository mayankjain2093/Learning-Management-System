<% layout('/layouts/boilerplate.ejs') %>
    <h1>All Courses</h1>
    <div>
        <a href="/courses/new">Add course</a>
    </div>
    
        <% for( let course of courses ) { %>
            <div class="card mb-3">
                <div class="row">
                    <div class="col-md-4">
                        <img src="<%= course.images[0].url %>" alt="" class="img-fluid">
                    </div>
                    <div class="col-md-8">
                        <div class="card-body">
                            <h5 class="card-title"><%= course.title %></h5>
                            <p class="card-text"><%= course.description %></p>
                            <p class="card-text">
                                <small class="text-muted"><%= course.author.username %></small>
                            </p>
                            <a href="/courses/<%= course._id %>" class="btn btn-primary">View <%= course.title %></a>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>
    
