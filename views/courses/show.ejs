<% layout('/layouts/boilerplate.ejs') %>
    <div class="row">
        <div class="col-6 offset-3">
            <div class="card mb-3">
                <img src="<%= course.image %>" class="card-img-top" alt="...">
                <div class="card-body">
                    <h5 class="card-title">
                        <%= course.title %>
                    </h5>
                    <p class="card-text">
                        <%= course.description %>
                    </p>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item text-muted">
                        <%= course.instructor %>
                    </li>
                    <li class="list-group-item">$<%= course.price %></li>
                    <!-- <li class="list-group-item">A third item</li> -->
                </ul>
                <div class="card-body">
                    <a href="/courses/<%= course._id %>/edit" class="card-link btn btn-warning">Edit</a>
                    <form class="d-inline" action="/courses/<%= course._id %>?_method=DELETE" method="POST">
                        <button class="btn btn-danger">Delete</button>
                    </form>
                </div>
                <div class="card-footer text-muted">
                    2 days ago
                </div>
            </div>
        
            <h2>Leave a Review</h2>
            <form action="/courses/<%= course._id %>/reviews" class="mb-3 validated-form" method="POST" novalidate>
                <div class="mb-3">
                    <label class="form-label" for="rating">Rating</label>
                    <input type="range" min="1" max="5" name="review[rating]" id="rating" class="form-range">
                </div>
                <div class="mb-3">
                    <label class="form-label" for="body">Review</label>
                    <textarea name="review[body]" id="body" cols="30" row="5" class="form-control" required></textarea>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                </div>
                <button class="btn btn-success">Submit</button>
            </form>   
        </div>
    </div>
